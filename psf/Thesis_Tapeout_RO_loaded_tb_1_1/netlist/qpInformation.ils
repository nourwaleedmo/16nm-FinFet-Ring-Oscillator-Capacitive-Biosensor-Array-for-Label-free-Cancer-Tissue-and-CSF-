(nil plottableAnalyses tran(ac noise dc) signals ((nil fullName "/I0/VDD" sigExpr "IT(\"/I0/VDD\")")) plottableExpressions ((nil name "V/V /V0; xf dB20(V/V)" expression db(getData("/V0" ?result "xf"))) (nil name "Tuning Parameter V" expression getData("V" ?result 'hb_osctp)) (nil name "p(/V0/PLUS /net7); hb dBmP; 1" expression dbm(harmonic(pvi('hb "/net7" 0 "/V0/PLUS" 0) 1))) (nil name "p(/V0/PLUS /net7); hb dBmP" expression dbm(pvi('hb "/net7" 0 "/V0/PLUS" 0))) (nil name "output noise: (AM, DSB, dBc/Hz)" expression rfOutputNoise("dBc/Hz" ?result "hbnoise_am" ?noiseConvention "DSB")) (nil name "p(10K /OUT); pss dBmP; 1" expression dbm(harmonic(pvr('pss "/OUT" 0 10000) 1))) (nil name "p(10K /OUT); pss dBmP" expression dbm(pvr('pss "/OUT" 0 10000))) (nil name "Jcc[Second]:rms" expression drplRFJcc(?from 0.0009999 ?to 2000000 ?k 10 ?multiplier 1 ?result "hbnoise_pm" ?unit "Second")) (nil name "Jc[Second]:rms" expression drplRFJc(?from 0.0009999 ?to 2000000 ?k 10 ?multiplier 1 ?result "hbnoise_pm" ?unit "Second")) (nil name "(V:CorFreq:PN-3dB)" expression "list(8.00e-01 1.827e+05 -1.52e+02)") (nil name "deriv of freq vs VDD" expression deriv(harmonic(xval(getData("OUT" ?result "hb_fd")) '1))) (nil name "harm=1 freq; hb (Hz)" expression harmonic(xval(getData("OUT" ?result "hb_fd")) '1)) (nil name "i /V0/PLUS; hb dB20(I)" expression db(rms(ih('hb "/V0/PLUS")))) (nil name "i /V0/PLUS; hb mag(I)" expression rms(ih('hb "/V0/PLUS"))) (nil name "p(50. /OUT); hb dBmP; 1" expression dbm(harmonic(pvr('hb "/OUT" 0 50.0) 1))) (nil name "p(50. /OUT); hb dBmP" expression dbm(pvr('hb "/OUT" 0 50.0))) (nil name "p(50. /OUT); hb magP; 1" expression harmonic(pvr('hb "/OUT" 0 50.0) 1)) (nil name "p(50. /OUT); hb magP" expression pvr('hb "/OUT" 0 50.0)) (nil name "v /OUT; 1; hb mag(V)" expression mag(harmonic(rms(vh('hb "/OUT")) 1))) (nil name "v /OUT; hb mag(V)" expression rms(vh('hb "/OUT"))) (nil name "v /OUT; tstab (V)" expression v("/OUT" ?result "hb_tran"))))